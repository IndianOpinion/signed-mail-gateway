<?xml version="1.0"?>
<ruleset name="signed-mail-gateway">
    <description>PSR-12 for the client.</description>
    <file>src</file>
    <file>tests</file>
    <file>functions.php</file>
    <file>bootstrap.php</file>
    <file>signed-mail-gateway.php</file>
    <file>uninstall.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="150"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
    <!-- Entry files and the global functions file have side effects by design. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>bootstrap.php</exclude-pattern>
        <exclude-pattern>signed-mail-gateway.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>functions.php</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <!-- Test method names describe the PRD case they cover. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/</exclude-pattern>
    </rule>
</ruleset>
