{
    "name": "indianopinion/signed-mail-gateway",
    "description": "WordPress client for signed-mail-gateway: sends wp_mail() through an HMAC-signed Cloudflare Worker, with a safe one-time fallback to the normal mail path.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "homepage": "https://github.com/IndianOpinion/signed-mail-gateway",
    "support": {
        "issues": "https://github.com/IndianOpinion/signed-mail-gateway/issues",
        "email": "hello@indianopinion.org"
    },
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\SignedMailGateway\\": "src/"
        },
        "files": [
            "functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\SignedMailGateway\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpmailer/phpmailer": "^7.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
