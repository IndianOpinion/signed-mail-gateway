{
  "name": "@indianopinion/signed-mail-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that sends mail through Cloudflare Email Sending only for HMAC-signed, fresh, never-seen requests.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.7.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
